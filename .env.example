# Copy this to .env and edit if you need to. Don't commit your .env.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# These match docker-compose.yml, so it should just work after docker compose up.
DATABASE_URL=postgres://spartieswap:spartieswap@localhost:5432/spartieswap

# Only emails at this domain can sign up.
CAMPUS_EMAIL_DOMAIN=case.edu
